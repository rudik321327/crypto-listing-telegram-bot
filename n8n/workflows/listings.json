{
  "id": "cryptoListings01",
  "name": "Crypto listing announcements",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none"
  },
  "nodes": [
    {
      "id": "6f1b2c10-0001-4a8e-9a11-000000000001",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "6f1b2c10-0002-4a8e-9a11-000000000002",
      "name": "Collect announcements",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_URL }}/api/collect",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Token",
              "value": "={{ $env.API_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 180000
        }
      }
    },
    {
      "id": "6f1b2c10-0003-4a8e-9a11-000000000003",
      "name": "Split announcements",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [480, 0],
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      }
    },
    {
      "id": "6f1b2c10-0004-4a8e-9a11-000000000004",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_URL }}/api/broadcast",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Token",
              "value": "={{ $env.API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1000
            }
          }
        }
      }
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [[{ "node": "Collect announcements", "type": "main", "index": 0 }]]
    },
    "Collect announcements": {
      "main": [[{ "node": "Split announcements", "type": "main", "index": 0 }]]
    },
    "Split announcements": {
      "main": [[{ "node": "Send to Telegram", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {}
}
